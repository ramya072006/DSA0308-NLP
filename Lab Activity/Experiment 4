def plural(noun):
    if noun.endswith("s"):
        return noun + "es"
    elif noun.endswith(("sh", "ch", "x", "z")):
        return noun + "es"
    elif noun.endswith("y") and noun[-2] not in "aeiou":
        return noun[:-1] + "ies"
    else:
        return noun + "s"
nouns = ["cat", "dog", "bus", "box", "baby"]
for noun in nouns:
    print(noun, "->", plural(noun))
